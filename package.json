{
  "name": "pocketbook",
  "productName": "Pocketbook",
  "version": "0.1.0",
  "description": "A local-first annual budget app: Numi-style calculator sheets, cash-flow diagrams, and a Coast FIRE planner.",
  "main": "./out/main/index.js",
  "author": "Elizabeth Langlois",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.mjs",
    "test": "node --test test/",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.elangloi.pocketbook",
    "productName": "Pocketbook",
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {
    "d3-sankey": "^0.12.3",
    "d3-shape": "^3.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
